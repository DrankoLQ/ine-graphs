---
import Layout from '../layouts/Layout.astro';

const stories = [
  {
    href: '/piramide',
    theme: 'Demografía',
    title: 'España envejece por la base',
    hook: 'La edad más común pasó de 16 a 48 años. La pirámide de población, animada entre 1981 y 2025.',
  },
  {
    href: '/inflacion',
    theme: 'Precios',
    title: 'No todo sube igual',
    hook: 'La comida sube un 41 %; la ropa, un 11 %. Y cada año de la serie tiene su propia historia.',
  },
  {
    href: '/paro',
    theme: 'Trabajo',
    title: 'Ser joven duplica el paro',
    hook: 'La tasa de los menores de 25 años llegó al 56,9 % en 2013. En el verano de 2026 es del 23,3 %, el doble que la general.',
  },
];
---

<Layout
  title="España, en datos — Gráficos del INE"
  description="Historias con datos del Instituto Nacional de Estadística: población, precios, trabajo y vivienda. Snapshots reproducibles, sin API en tiempo de ejecución."
>
  <header>
    <p class="eyebrow">INE · Datos abiertos</p>
    <h1>España, en datos</h1>
    <p class="standfirst">
      Historias con datos del Instituto Nacional de Estadística. Cada gráfico se
      descarga y valida en tiempo de compilación; el sitio no llama a la API en
      tiempo de ejecución.
    </p>
  </header>

  <section class="story-grid" aria-label="Historias">
    {
      stories.map((story) => (
        <a class="story-card" href={story.href}>
          <p class="story-kicker">{story.theme}</p>
          <h2>{story.title}</h2>
          <p class="story-hook">{story.hook}</p>
          <span class="story-arrow" aria-hidden="true">→</span>
        </a>
      ))
    }
  </section>

  <p class="hub-note">
    {stories.length} historias publicadas. Las fuentes y el método están en el pie
    de cada una.
  </p>
</Layout>

<style is:global>
  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .story-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 24px 48px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .story-card:hover {
    border-color: #c9c5bb;
    transform: translateY(-1px);
  }

  .story-kicker {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .story-card h2 {
    margin: 0;
    font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    font-size: clamp(22px, 3vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .story-hook {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: #45443f;
    max-width: 42ch;
  }

  .story-arrow {
    position: absolute;
    right: 22px;
    bottom: 18px;
    font-size: 18px;
    color: var(--muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .story-card:hover .story-arrow {
    transform: translateX(3px);
    color: var(--ink);
  }

  .hub-note {
    margin: 22px 0 0;
    font-size: 12px;
    color: var(--muted);
  }

  @media (min-width: 620px) {
    .story-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .story-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .story-card {
      padding: 20px 20px 44px;
    }
  }
</style>
