---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/', label: 'Pirámide' },
  { href: '/inflacion', label: 'Inflación' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta name="theme-color" content="#fbfaf7" />
  </head>
  <body>
    <nav class="nav" aria-label="Historias">
      <a class="brand" href="/">INE · Gráficos</a>
      <div class="nav-links">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={path === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </nav>

    <main class="wrap">
      <slot />
    </main>

    <footer class="foot">
      <p>
        Datos del Instituto Nacional de Estadística. Licencia
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a>.
        Proyecto local, sin llamadas al INE en tiempo de ejecución.
      </p>
    </footer>
  </body>
</html>
